# OpenAI-compatible LLM configuration for DSPy keyword generation.
# Copy this file to .env and fill in your values.

# Required: your API key (any OpenAI-compatible provider works).
OPENAI_API_KEY=sk-your-api-key-here

# Required: model name (e.g. gpt-4o-mini, gpt-4o, claude-3-sonnet-20240229, etc.)
OPENAI_MODEL_NAME=gpt-4o-mini

# Optional: custom API base URL (leave commented for official OpenAI).
# OPENAI_BASE_URL=https://api.openai.com/v1

# For local providers (e.g. Ollama, vLLM, LM Studio):
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL_NAME=some-local-model
